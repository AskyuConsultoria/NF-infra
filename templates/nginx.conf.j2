server {
    listen 80;
    server_name localhost;


    root /usr/share/nginx/html/src;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }


    location = /upload {
        try_files /public/upload/upload.html =404;
    }


    location = /visualizacao {
        try_files /public/fornecedor/visualizacao.html =404;
    }


    location = /individual {
        try_files /public/fornecedor/individual.html =404;
    }


    location = /password_recovery {
        try_files /public/password_recovery/password_recovery.html =404;
    }


    location = /permissionamento {
    try_files /public/permissionamento/acesso.html =404;
    }

    location ~ ^/cadastros/([^/]+)$ {
        try_files /public/cadastros/cadastros-$1.html =404;
    }


    location = /cadastros/departamentos/detalhes {
        try_files /public/cadastros/cadastros-departamentos-details.html =404;
    }


    location /syntro/ {
        proxy_pass http://{{ backend_ip }}:8080/syntro/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
